# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
.next/
out/
.vercel/

# generated by `next dev`/`next build`, restored on every run
next-env.d.ts

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
.idea/
*.swp

# test / coverage
coverage/

# The SQLite source corpus in data-collection/ is tracked, via Git LFS — see
# .gitattributes. Ignore only the sidecar files SQLite writes next to a database
# it has open, which are transient and must never be committed.
data-collection/*.db-wal
data-collection/*.db-shm
data-collection/*.db-journal
